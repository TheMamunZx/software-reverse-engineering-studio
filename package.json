{
  "name": "software-reverse-engineering-studio",
  "version": "0.1.0",
  "description": "Agent-native reverse engineering platform with MCP integration",
  "license": "Apache-2.0",
  "author": "SRE Studio Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheMamunZx/software-reverse-engineering-studio.git"
  },
  "bugs": {
    "url": "https://github.com/TheMamunZx/software-reverse-engineering-studio/issues"
  },
  "homepage": "https://github.com/TheMamunZx/software-reverse-engineering-studio#readme",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "build:core": "pnpm --filter=@sre-studio/core run build",
    "build:mcp-server": "pnpm --filter=@sre-studio/mcp-server run build",
    "build:cli": "pnpm --filter=@sre-studio/cli run build",
    "build:shared": "pnpm --filter=@sre-studio/shared run build",
    "build:providers": "pnpm --filter=@sre-studio/provider-* run build",
    "dev": "pnpm --filter=@sre-studio/cli run dev",
    "test": "pnpm -r run test",
    "test:core": "pnpm --filter=@sre-studio/core run test",
    "test:mcp-server": "pnpm --filter=@sre-studio/mcp-server run test",
    "test:cli": "pnpm --filter=@sre-studio/cli run test",
    "test:shared": "pnpm --filter=@sre-studio/shared run test",
    "test:providers": "pnpm --filter=@sre-studio/provider-* run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "benchmark": "node scripts/benchmark.mjs",
    "pack:audit": "node scripts/pack-audit.mjs",
    "clean": "pnpm -r run clean && node scripts/clean.mjs node_modules",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "tsx": "^4.15.0",
    "tsup": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}