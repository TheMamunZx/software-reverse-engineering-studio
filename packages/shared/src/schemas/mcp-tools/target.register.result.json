{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sre-studio.dev/schemas/mcp-tools/target.register.result.json",
  "version": "1.0.0",
  "title": "Target Register Tool Output",
  "type": "object",
  "required": ["targetId", "sessionId"],
  "properties": {
    "targetId": { "type": "string", "pattern": "^tgt_[a-f0-9]{16}$" },
    "sessionId": { "type": "string", "pattern": "^ses_[a-f0-9]{16}$" }
  },
  "additionalProperties": false
}