{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@sre-studio/shared/*": ["packages/shared/src/*"],
      "@sre-studio/core/*": ["packages/core/src/*"],
      "@sre-studio/mcp-server/*": ["packages/mcp-server/src/*"],
      "@sre-studio/cli/*": ["packages/cli/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}