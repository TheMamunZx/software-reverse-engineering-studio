{
  "name": "@sre-studio/core",
  "version": "0.1.0",
  "description": "Core engine for SRE Studio - session management, evidence engine, capability registry",
  "license": "Apache-2.0",
  "author": "SRE Studio Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheMamunZx/software-reverse-engineering-studio.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@sre-studio/shared": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@sre-studio/tsconfig": "workspace:*",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}