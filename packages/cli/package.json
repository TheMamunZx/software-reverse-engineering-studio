{
  "name": "@sre-studio/cli",
  "version": "0.1.0",
  "description": "CLI for SRE Studio - investigation management and analysis",
  "license": "Apache-2.0",
  "author": "SRE Studio Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheMamunZx/software-reverse-engineering-studio.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sre-studio": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@sre-studio/core": "workspace:*",
    "@sre-studio/shared": "workspace:*",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0"
  },
  "devDependencies": {
    "@sre-studio/provider-android": "workspace:*",
    "@sre-studio/provider-binary": "workspace:*",
    "@sre-studio/tsconfig": "workspace:*",
    "@types/handlebars": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.15.0"
  }
